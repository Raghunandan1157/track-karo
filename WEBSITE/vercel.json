{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/stream.js": { "maxDuration": 300 }
  },
  "crons": [{ "path": "/api/cron", "schedule": "30 15 * * *" }],
  "headers": [
    { "source": "/(js|css)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
